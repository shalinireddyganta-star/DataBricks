bundle:
  name: retaillakeflowbundle
  uuid: 690d7cbd-358f-42a0-95f1-9073c780db76

include:
  - resources/*.yml
  - src/environments/*.yml

# Variable declarations. These variables are assigned in the dev/prod targets below.
variables:
  catalog:
    description: The catalog to use
  schema:
    description: The schema to use
  Bronzeretailschema:
     description: The Bronze schema
  Bronzeretailcatalog:
      description: The Bronze catalog


targets:
  dev:
    # The default target uses 'mode: development' to create a development copy.
    ## Deployed resources get prefixed with '[dev my_user_name]'
    # Deployed resources get prefixed with '[dev acme_corp]'
    #/Workspace/Repos/Repos/Databricks/Retail_Orders_Bundle/src/retaillakeflowpipelines/transformations/Bronze/ Bronze_OrderMain_Transformation.py - Any job schedules and triggers are paused by default.
    # See also https://docs.databricks.com/dev-tools/bundles/deployment-modes.html.
    mode: development
    default: true
    workspace:
      host: https://dbc-75f3f777-70d3.cloud.databricks.com
    variables:
      catalog: retailrawdev
      schema: dev
      Bronzeretailcatalog: retailrawdev
      Bronzeretailschema: retailrawdev
  prod:
    mode: production
    workspace:
      host: https://dbc-75f3f777-70d3.cloud.databricks.com
      # We explicitly deploy to /Workspace/Users/shalinireddyganta@gmail.com to make sure we only have a single copy.
      root_path: /Workspace/Users/shalinireddyganta@gmail.com/.bundle/${bundle.name}/${bundle.target}
    variables:
      catalog: retailrawprod
      schema: prod
      Bronzeretailcatalog: retailrawprod
      Bronzeretailschema: retailrawprod
    permissions:
      - user_name: shalinireddyganta@gmail.com
        level: CAN_MANAGE
